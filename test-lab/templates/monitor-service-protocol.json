{
  "identityConfigFile": "__TEST_LAB_ROOT__/config/device_identity.json",
  "deviceConfigFiles": ["__DEVICE_CONFIG_FILE__", "__COMPUTE_CONFIG_FILE__"],
  "mqtt": {"enabled": __MQTT_ENABLED__, "broker": "__MQTT_BROKER__", "clientId": "SIM_COMM202600999", "topicMachineCode": "SIM_COMM202600999"},
  "mqttDriver": {
    "enabled": true,
    "sharedMemoryName": "__SHARED_MEMORY_NAME__",
    "sharedMemoryNames": ["__SHARED_MEMORY_NAME__"],
    "scanIntervalMs": 200,
    "fullUploadIntervalMs": 1000,
    "publishFullOnStart": true,
    "publishAllOnFull": true,
    "priorityControlLeaseFile": "__TEST_LAB_ROOT__/run/priority-control.json"
  },
  "alarmStore": {"enabled": false},
  "eventEngine": {
    "enabled": true,
    "deliveryMode": "hybrid",
    "scanIntervalMs": 100,
    "scanFallbackIntervalMs": 1000,
    "publishMode": "direct_mqtt",
    "mqttClientIdSuffix": "test_lab_event"
  },
  "computeEngine": {
    "enabled": true,
    "sharedMemoryNames": ["__SHARED_MEMORY_NAME__"],
    "outputDefaultSharedMemoryName": "__SHARED_MEMORY_NAME__",
    "scanIntervalMs": 100,
    "maxRuleEvalPerScan": 16,
    "rules": [
      {
        "ruleCode": "test_lab_double",
        "name": "模拟源点二倍值",
        "enabled": true,
        "trigger": {"type": "interval", "intervalMs": 200},
        "inputs": [{"name": "source", "index": __COMPUTE_SOURCE_INDEX__, "required": true}],
        "outputs": [{"name": "SIM_COMPUTE_DOUBLE", "index": 999901, "mode": "latestOnly", "sharedMemoryName": "__SHARED_MEMORY_NAME__", "ttlMs": 3000, "qualityPolicy": "bad_if_any_input_bad"}],
        "script": {"type": "expression", "expression": "if(valid(source), source * 2, null)"}
      }
    ]
  },
  "realtime": {"enabled": false},
  "systemMonitor": {
    "enabled": true,
    "defaultIntervalMs": 1000,
    "minIntervalMs": 200,
    "subscriptionTtlSec": 30,
    "diagEnabled": false,
    "configPullChunkBytes": 131072,
    "realtimeMeterLeaseFile": "__TEST_LAB_ROOT__/run/realtime-meter-leases.json",
    "cellular": {"enabled": false},
    "recordingTransfer": {"enabled": false},
    "directMaintenance": {
      "enabled": true,
