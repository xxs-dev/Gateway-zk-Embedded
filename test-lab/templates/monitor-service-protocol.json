      "identityConfigFile": "__TEST_LAB_ROOT__/config/device_identity.json",
      "appConfigFile": "__TEST_LAB_ROOT__/config/apps/monitor-service.json",
      "otaAppConfigFile": "__TEST_LAB_ROOT__/config/apps/monitor-service.json",
      "authStateFile": "__TEST_LAB_ROOT__/run/direct-maintenance-state.json",
