[Unit]
Description=KY EMS legacy Qt display data bridge
PartOf=ky-ems.service
Before=ky-ems.service

[Service]
Type=simple
ExecStart=/opt/modbus-gateway/bin/QtDisplayBridge --app-config /opt/modbus-gateway/config/runtime/apps/mqtt-service.json --var-list /opt/modbus-gateway/ky-ems/VarList.xml --interval-ms 500
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
