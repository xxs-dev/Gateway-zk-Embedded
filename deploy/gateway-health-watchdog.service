[Unit]
Description=Gateway Business Health Watchdog
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/gateway-health-watchdog
ExecStart=/opt/modbus-gateway/bin/gateway-health-watchdog.sh run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
