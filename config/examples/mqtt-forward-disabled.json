{
  "identityConfigFile": "runtime/device_identity.json",
  "deviceConfigFiles": [
    "runtime/devices/device_slave_ttySP1.json"
  ],
  "mqtt": {
    "enabled": true,
    "protocolVersion": "mqtt3",
    "broker": "tcp://127.0.0.1:1883",
    "clientId": "GW0001",
    "fullTelemetryTopic": "edge/telemetry/full",
    "realtimeTelemetryTopic": "edge/telemetry/realtime",
    "changeEventTopicMachineScoped": true,
    "alarmTopicMachineScoped": true,
    "commandRequestTopic": "edge/command/request",
    "commandReplyTopic": "edge/command/reply"
  },
  "mqttForward": {
    "enabled": false,
    "protocolVersion": "mqtt3",
    "broker": "",
    "fullTelemetryTopic": "",
    "fullTelemetryTopicMachineScoped": true,
    "pointIndexes": [],
    "payloadFormat": "compactArray",
    "legacyTelemetryMappedOnly": false,
    "legacyTelemetryPointMappings": [],
    "username": "",
    "password": "",
    "qos": 1,
    "intervalMs": 60000,
    "retryMinMs": 500,
    "retryMaxMs": 5000,
    "healthHeartbeatMs": 1000,
    "failOnStoreError": true,
    "events": {
      "enabled": false,
      "targetId": "third-party",
      "changeTopic": "third/event/change",
      "alarmTopic": "third/alarm",
      "changeTopicMachineScoped": true,
      "alarmTopicMachineScoped": true,
      "pointIndexes": [],
      "replayIntervalMs": 100,
      "replayMaxBytes": 262144
    },
    "tls": {
      "enabled": false,
      "caFile": "",
      "certFile": "",
      "keyFile": "",
      "insecureSkipVerify": false
    },
    "control": {
      "enabled": false
    }
  },
  "mqttDriver": {
    "enabled": true,
    "sharedMemoryName": "gateway_point_store",
    "fullUploadWorker": {
      "mode": "inline",
      "clientIdSuffix": "-full",
      "healthFile": "/run/modbus-gateway/mqtt-primary-full-{instance}-health.json",
      "publishLockFile": "/opt/modbus-gateway/run/mqtt-primary-full-{instance}.lock",
      "healthHeartbeatMs": 1000,
      "failoverTimeoutMs": 3000,
      "retryMinMs": 500,
      "retryMaxMs": 5000,
      "eventForwardingEnabled": false,
      "eventReplayLockFile": "/opt/modbus-gateway/run/mqtt-primary-events-{instance}.lock",
      "eventDelegationReadyFile": "/opt/modbus-gateway/run/mqtt-event-delegation-{instance}.json"
    }
  }
}
