<?xml version="1.0" encoding="UTF-8"?>
<!--
    KY-EMS 全局数据点配置文件
    ========================================================================
    参考 SmartSG 的 SmartSGConfig.xml 架构，以页面为单位配置数据源。
    VarList : QRamRT 库的变量表路径，与可执行文件同目录
    appDataIndex : VarList.xml 中定义的数据点索引；0 表示未接入
    ========================================================================
-->
<KYEMSConfig>

    <!-- VarList.xml 由嵌入式系统数采程序维护，与可执行文件放在同一目录 -->
    <VarList path="VarList.xml"/>
    <!-- PointMap 由当前网关工程导出；新画面优先用 meterCode+pointCode，index 仅作兜底 -->
    <PointMap path="KY-EMS-PointMap.example.json"
              appConfig="/opt/modbus-gateway/config/runtime/apps/mqtt-service.json"/>

    <!-- ================================================================
         DataTable 页面（数据曲线 + 数据报表）
         16 条波形：台区P×4 + 储能P×4 + 台区Q×4 + 储能Q×4
         ================================================================ -->
    <DataTable>
        <WaveformCache>
            <SampleIntervalSec value="60"/>   <!-- 采集间隔（秒） -->
            <MaxPoints value="1440"/>          <!-- 最大缓存点数 -->
        </WaveformCache>

        <Waves>
            <!-- ── 台区有功 P（实线，左轴 kW）── -->
            <Wave name="台区Pa" unit="kW" semanticRole="meter.grid.activePowerA" indexFallback="1036" color="#F9CC44" penStyle="SolidLine" axis="left" checkbox="checkBoxTqPa"/>
            <Wave name="台区Pb" unit="kW" semanticRole="meter.grid.activePowerB" indexFallback="1037" color="#129A37" penStyle="SolidLine" axis="left" checkbox="checkBoxTqPb"/>
            <Wave name="台区Pc" unit="kW" semanticRole="meter.grid.activePowerC" indexFallback="1038" color="#DD5353" penStyle="SolidLine" axis="left" checkbox="checkBoxTqPc"/>
            <Wave name="台区P"  unit="kW" semanticRole="meter.gridActivePower" indexFallback="1039" color="#20DBE9" penStyle="SolidLine" axis="left" checkbox="checkBoxTqP"/>

            <!-- ── 储能有功 P（虚线，左轴 kW）── -->
            <Wave name="储能Pa" unit="kW" semanticRole="meter.storage.activePowerA" indexFallback="1136" color="#F9CC44" penStyle="DashLine" axis="left" checkbox="checkBoxEnStorePa"/>
            <Wave name="储能Pb" unit="kW" semanticRole="meter.storage.activePowerB" indexFallback="1137" color="#129A37" penStyle="DashLine" axis="left" checkbox="checkBoxEnStorePb"/>
            <Wave name="储能Pc" unit="kW" semanticRole="meter.storage.activePowerC" indexFallback="1138" color="#DD5353" penStyle="DashLine" axis="left" checkbox="checkBoxEnStorePc"/>
            <Wave name="储能P"  unit="kW" semanticRole="meter.storageActivePower" indexFallback="1139" color="#20DBE9" penStyle="DashLine" axis="left" checkbox="checkBoxEnStoreP"/>

            <!-- ── 台区无功 Q（点线，右轴 kVar）── -->
            <Wave name="台区Qa" unit="kVar" semanticRole="meter.grid.reactivePowerA" indexFallback="1040" color="#FF9626" penStyle="DotLine" axis="right" checkbox="checkBoxTqQa"/>
            <Wave name="台区Qb" unit="kVar" semanticRole="meter.grid.reactivePowerB" indexFallback="1041" color="#84B723" penStyle="DotLine" axis="right" checkbox="checkBoxTqQb"/>
            <Wave name="台区Qc" unit="kVar" semanticRole="meter.grid.reactivePowerC" indexFallback="1042" color="#CB2B88" penStyle="DotLine" axis="right" checkbox="checkBoxTqQc"/>
            <Wave name="台区Q"  unit="kVar" semanticRole="meter.gridReactivePower" indexFallback="1043" color="#4087F1" penStyle="DotLine" axis="right" checkbox="checkBoxTqQ"/>

            <!-- ── 储能无功 Q（点划线，右轴 kVar）── -->
            <Wave name="储能Qa" unit="kVar" semanticRole="meter.storage.reactivePowerA" indexFallback="1140" color="#FF9626" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQa"/>
            <Wave name="储能Qb" unit="kVar" semanticRole="meter.storage.reactivePowerB" indexFallback="1141" color="#84B723" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQb"/>
            <Wave name="储能Qc" unit="kVar" semanticRole="meter.storage.reactivePowerC" indexFallback="1142" color="#CB2B88" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQc"/>
            <Wave name="储能Q"  unit="kVar" semanticRole="meter.storageReactivePower" indexFallback="1143" color="#4087F1" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQ"/>
        </Waves>
    </DataTable>

    <!-- ================================================================
         FirstPage 首页（主监控页）
         包含：能量统计 + 有功/无功功率 + 进度条
         ================================================================ -->
    <FirstPage>
        <DataBindings>
            <!-- ── 控制模式 ── -->
            <Bind widget="CtlModeColor" type="image" semanticRole="ems.controlMode" indexFallback="1"
                  meterCode="EMS_CORE" pointCode="ems_auto_mode"
                  value0Image=":/new/prefix1/Pictures/RingG.png"
                  value1Image=":/new/prefix1/Pictures/RingR.png">
                <StateRules labelWidget="CtlModeText" defaultCode="UNKNOWN" defaultLabel="未知" defaultColor="#AAB3BD" defaultImage="">
                    <State code="MANUAL" label="手动" color="#D64545" image=":/new/prefix1/Pictures/RingR.png" priority="100" match="all">
                        <Condition meterCode="EMS_CORE" pointCode="ems_auto_mode" indexFallback="1" semanticRole="ems.controlMode" operator="eq" value="1"/>
                    </State>
                    <State code="AUTO" label="自动" color="#2F9D78" image=":/new/prefix1/Pictures/RingG.png" priority="90" match="all">
                        <Condition meterCode="EMS_CORE" pointCode="ems_auto_mode" indexFallback="1" semanticRole="ems.controlMode" operator="eq" value="0"/>
                    </State>
                </StateRules>
            </Bind>  <!-- 控制模式：灯色与文字由同一组多状态规则驱动 -->
            <Bind widget="CtlModeText" type="text" semanticRole="ems.controlMode" indexFallback="1"
                  meterCode="EMS_CORE" pointCode="ems_auto_mode" decimals="0"
                  value0Text="自动" value1Text="手动"/>                <!-- 控制模式文本 -->

            <!-- ── SOC 显示 ── -->
            <Bind widget="SocData"     type="text" semanticRole="bms.soc" indexFallback="1569" decimals="1"/>  <!-- SOC 数值(%) -->
            <Bind widget="SocLabel"    type="progress" semanticRole="bms.soc" indexFallback="1569" targetWidget="SocLabel" maxWidth="160" maxValue="100"/>  <!-- SOC 进度条(100%=160px) -->

            <!-- ── 能量统计 ── -->
            <Bind widget="CanChargeEnData_2"   semanticRole="bms.chargeEnergyAvailable" indexFallback="1590" decimals="2"/>  <!-- 可充电量(kWh) -->
            <Bind widget="CanDisChargeEnData"  semanticRole="bms.dischargeEnergyAvailable" indexFallback="1591" decimals="2"/>  <!-- 可放电量(kWh) -->
            <Bind widget="TotChargeEnData"     semanticRole="bms.chargeEnergyToday" indexFallback="1615" decimals="2"/>  <!-- 今日充电量(kWh) -->
            <Bind widget="TotDisChargeEnData"  semanticRole="bms.dischargeEnergyToday" indexFallback="1616" decimals="2"/>  <!-- 今日放电量(kWh) -->
            
            <!-- ── 运行统计 ── -->
            <Bind widget="SafyRunData" semanticRole="ems.safeRunDays" indexFallback="6" decimals="0"/>      <!-- 安全运行天数 -->
            
            <!-- ── 有功功率 ── -->
            <Bind widget="EnStorePData" semanticRole="meter.storageActivePower" indexFallback="1139" unit="kW" decimals="1"/>      <!-- 储能有功功率(kW) -->
            <Bind widget="tqPData" semanticRole="meter.gridActivePower" indexFallback="1039" unit="kW" decimals="1"/>      <!-- 台区有功功率(kW) -->
            
            <!-- ── 无功功率 ── -->
            <Bind widget="EnStorePData_2" semanticRole="meter.storageReactivePower" indexFallback="1143" unit="kVar" decimals="1"/>      <!-- 储能无功功率(kVar) -->
            <Bind widget="tqPData_2" semanticRole="meter.gridReactivePower" indexFallback="1043" unit="kVar" decimals="1"/>      <!-- 台区无功功率(kVar) -->

            <!-- ── 双向进度条（BilateralProgressBar，数值范围±100）── -->
            <Bind widget="progBarEsP" type="bar" semanticRole="meter.storageActivePower" indexFallback="1139"/>   <!-- 储能有功功率进度条 -->
            <Bind widget="progBarTqP" type="bar" semanticRole="meter.gridActivePower" indexFallback="1039"/>   <!-- 台区有功功率进度条 -->
            <Bind widget="progBarEsQ" type="bar" semanticRole="meter.storageReactivePower" indexFallback="1143"/>   <!-- 储能无功功率进度条 -->
            <Bind widget="progBarTqQ" type="bar" semanticRole="meter.gridReactivePower" indexFallback="1043"/>   <!-- 台区无功功率进度条 -->
        </DataBindings>
    </FirstPage>

    <!-- ================================================================
         MainPage_2 波形页（16条波形 + 数据绑定）
         ================================================================ -->
    <MainPage_2>
        <Waves>
            <!-- 与 DataTable 相同的 16 条波形配置 -->
            <Wave name="台区Pa" unit="kW" semanticRole="meter.grid.activePowerA" indexFallback="1036" color="#F9CC44" penStyle="SolidLine" axis="left" checkbox="checkBoxTqPa"/>
            <Wave name="台区Pb" unit="kW" semanticRole="meter.grid.activePowerB" indexFallback="1037" color="#129A37" penStyle="SolidLine" axis="left" checkbox="checkBoxTqPb"/>
            <Wave name="台区Pc" unit="kW" semanticRole="meter.grid.activePowerC" indexFallback="1038" color="#DD5353" penStyle="SolidLine" axis="left" checkbox="checkBoxTqPc"/>
            <Wave name="台区P" unit="kW" semanticRole="meter.gridActivePower" indexFallback="1039" color="#20DBE9" penStyle="SolidLine" axis="left" checkbox="checkBoxTqP"/>
            <Wave name="储能Pa" unit="kW" semanticRole="meter.storage.activePowerA" indexFallback="1136" color="#F9CC44" penStyle="DashLine" axis="left" checkbox="checkBoxEnStorePa"/>
            <Wave name="储能Pb" unit="kW" semanticRole="meter.storage.activePowerB" indexFallback="1137" color="#129A37" penStyle="DashLine" axis="left" checkbox="checkBoxEnStorePb"/>
            <Wave name="储能Pc" unit="kW" semanticRole="meter.storage.activePowerC" indexFallback="1138" color="#DD5353" penStyle="DashLine" axis="left" checkbox="checkBoxEnStorePc"/>
            <Wave name="储能P" unit="kW" semanticRole="meter.storageActivePower" indexFallback="1139" color="#20DBE9" penStyle="DashLine" axis="left" checkbox="checkBoxEnStoreP"/>
            <Wave name="台区Qa" unit="kVar" semanticRole="meter.grid.reactivePowerA" indexFallback="1040" color="#FF9626" penStyle="DotLine" axis="right" checkbox="checkBoxTqQa"/>
            <Wave name="台区Qb" unit="kVar" semanticRole="meter.grid.reactivePowerB" indexFallback="1041" color="#84B723" penStyle="DotLine" axis="right" checkbox="checkBoxTqQb"/>
            <Wave name="台区Qc" unit="kVar" semanticRole="meter.grid.reactivePowerC" indexFallback="1042" color="#CB2B88" penStyle="DotLine" axis="right" checkbox="checkBoxTqQc"/>
            <Wave name="台区Q" unit="kVar" semanticRole="meter.gridReactivePower" indexFallback="1043" color="#4087F1" penStyle="DotLine" axis="right" checkbox="checkBoxTqQ"/>
            <Wave name="储能Qa" unit="kVar" semanticRole="meter.storage.reactivePowerA" indexFallback="1140" color="#FF9626" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQa"/>
            <Wave name="储能Qb" unit="kVar" semanticRole="meter.storage.reactivePowerB" indexFallback="1141" color="#84B723" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQb"/>
            <Wave name="储能Qc" unit="kVar" semanticRole="meter.storage.reactivePowerC" indexFallback="1142" color="#CB2B88" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQc"/>
            <Wave name="储能Q" unit="kVar" semanticRole="meter.storageReactivePower" indexFallback="1143" color="#4087F1" penStyle="DashDotLine" axis="right" checkbox="checkBoxEnStoreQ"/>
        </Waves>
        <DataBindings>
            <!-- MainPage_2 波形页数据绑定，待实际接入 -->
        </DataBindings>
    </MainPage_2>

    <!-- ================================================================
         RunMon 运行监测页（系统概览）
         包含：负载数据表 + PCS 功率 + PCS 电压
         ================================================================ -->
    <RunMon>
        <DataBindings>
            <!-- ── 负载数据 P(kW) ── -->
            <Bind widget="label_16" semanticRole="meter.grid.activePowerA" indexFallback="1036" decimals="1"/>  <!-- P A相(kW) -->
            <Bind widget="label_18" semanticRole="meter.grid.activePowerB" indexFallback="1037" decimals="1"/>  <!-- P B相(kW) -->
            <Bind widget="label_20" semanticRole="meter.grid.activePowerC" indexFallback="1038" decimals="1"/>  <!-- P C相(kW) -->
            <Bind widget="label_23" semanticRole="meter.gridActivePower" indexFallback="1039" decimals="1"/>  <!-- P 总(kW) -->
            
            <!-- ── 负载数据 Q(kVar) ── -->
            <Bind widget="label_17" semanticRole="meter.grid.reactivePowerA" indexFallback="1040" decimals="1"/>  <!-- Q A相(kVar) -->
            <Bind widget="label_21" semanticRole="meter.grid.reactivePowerB" indexFallback="1041" decimals="1"/>  <!-- Q B相(kVar) -->
            <Bind widget="label_19" semanticRole="meter.grid.reactivePowerC" indexFallback="1042" decimals="1"/>  <!-- Q C相(kVar) -->
            <Bind widget="label_22" semanticRole="meter.gridReactivePower" indexFallback="1043" decimals="1"/>  <!-- Q 总(kVar) -->
            
            <!-- ── PCS 有功功率 P(kW) ── -->
            <Bind widget="label_25" semanticRole="pcs.activePowerA" indexFallback="1227" decimals="1"/>  <!-- P1(kW) -->
            <Bind widget="label_29" semanticRole="pcs.activePowerB" indexFallback="1228" decimals="1"/>  <!-- P2(kW) -->
            <Bind widget="label_32" semanticRole="pcs.activePowerC" indexFallback="1229" decimals="1"/>  <!-- P3(kW) -->
            
            <!-- ── PCS 无功功率 Q(kVar) ── -->
            <Bind widget="label_40" semanticRole="pcs.reactivePowerA" indexFallback="1231" decimals="1"/>  <!-- Q1(kVar) -->
            <Bind widget="label_35" semanticRole="pcs.reactivePowerB" indexFallback="1232" decimals="1"/>  <!-- Q2(kVar) -->
            <Bind widget="label_37" semanticRole="pcs.reactivePowerC" indexFallback="1233" decimals="1"/>  <!-- Q3(kVar) -->
            
            <!-- ── PCS 电压 U(V) ── -->
            <Bind widget="label_127" semanticRole="pcs.voltageA" indexFallback="1220" decimals="1"/>  <!-- U1(V) -->
            <Bind widget="label_131" semanticRole="pcs.voltageB" indexFallback="1221" decimals="1"/>  <!-- U2(V) -->
            <Bind widget="label_130" semanticRole="pcs.voltageC" indexFallback="1222" decimals="1"/>  <!-- U3(V) -->
        </DataBindings>
    </RunMon>

    <!-- ================================================================
         BmsMon BMS 监测页
         显示 SOC/SOH 及电池状态指示灯
         ================================================================ -->
    <BmsMon>
        <DataBindings>
            <!-- ── 电池状态 ── -->
            <Bind widget="label_Soc" semanticRole="bms.soc" indexFallback="1569" decimals="1"/>   <!-- SOC(%) -->
            <Bind widget="label_Soh" semanticRole="bms.soh" indexFallback="1570" decimals="1"/>   <!-- SOH(%) -->

            <!-- ── SOC/SOH 液位高度（100%对应270px）── -->
            <Bind widget="SocColor" type="progress" semanticRole="bms.soc" indexFallback="1569" targetWidget="SocColor" maxHeight="270" maxValue="100"/>  <!-- SOC 液位条 -->
            <Bind widget="SohColor" type="progress" semanticRole="bms.soh" indexFallback="1570" targetWidget="SohColor" maxHeight="270" maxValue="100"/>  <!-- SOH 液位条 -->

            <!-- 顶部 BMS 系统状态：接触器位图先在 PointMap 中归一化 -->
            <Bind widget="label_15" type="image" semanticRole="bms.contactorState" activeStates="PRECHARGING,ON"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle.png"/>
            <Bind widget="label_16" semanticRole="bms.contactorState" decimals="0"
                  valueMap="0=簇下电;1=预充中;2=簇上电;3=状态异常"/>

            <!-- 电池状态灯只绑定标准枚举；厂家原始值由 PointMap.semanticValueMap 归一化 -->
            <Bind widget="BatInit" type="image" semanticRole="bms.prechargeState" activeStates="STARTING,CONNECTING"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 电池初始化 -->
            <Bind widget="BatReady" type="image" semanticRole="bms.runState" activeStates="NORMAL"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 电池就绪 -->
            <Bind widget="BatCharge" type="image" semanticRole="bms.chargeDischargeState" activeStates="CHARGING"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 充电中 -->
            <Bind widget="BatDischarge" type="image" semanticRole="bms.chargeDischargeState" activeStates="DISCHARGING"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 放电中 -->
            <Bind widget="DisableCharge" type="image" semanticRole="bms.runState" activeStates="CHARGE_DISABLED"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 禁止充电 -->
            <Bind widget="DisableDischarge" type="image" semanticRole="bms.runState" activeStates="DISCHARGE_DISABLED"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 禁止放电 -->
            <Bind widget="BatDisableAll" type="image" semanticRole="bms.runState" activeStates="STANDBY,STOPPED"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 电池全部禁用 -->
            <Bind widget="BatFault" type="image" semanticRole="bms.fault"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 电池故障 -->

            <!-- ── 报警等级指示灯 ── -->
            <Bind widget="AlarmLvl1" type="image" semanticRole="bms.alarm.level1" indexFallback="8197"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 一级报警 -->
            <Bind widget="AlarmLvl2" type="image" semanticRole="bms.alarm.level2" indexFallback="8198"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 二级报警 -->
            <Bind widget="AlarmLvl3" type="image" semanticRole="bms.alarm.level3" indexFallback="8199"
                  value0Image=":/new/prefix1/Pictures/RunMonPics/Circle2.png"
                  value1Image=":/new/prefix1/Pictures/RunMonPics/Circle1.png"/>   <!-- 三级报警 -->

            <!-- ── 充放电统计数据 ── -->
            <Bind widget="ChargeKwh" semanticRole="bms.chargeEnergyToday" indexFallback="1615" decimals="2"/>    <!-- 今日充电量(kWh) -->
            <Bind widget="DischargeKwh" semanticRole="bms.dischargeEnergyToday" indexFallback="1616" decimals="2"/>    <!-- 今日放电量(kWh) -->
            <Bind widget="LastCharge" semanticRole="bms.lastChargeEnergy" indexFallback="1588" decimals="2"/>    <!-- 上次充电(kWh) -->
            <Bind widget="AddCharge" semanticRole="bms.chargeEnergyAvailable" indexFallback="1590" decimals="2"/>    <!-- 可充电量(kWh) -->
            <Bind widget="LastDischarge" semanticRole="bms.lastDischargeEnergy" indexFallback="1589" decimals="2"/>    <!-- 上次放电(kWh) -->
            <Bind widget="AddDischarge" semanticRole="bms.dischargeEnergyAvailable" indexFallback="1591" decimals="2"/>    <!-- 可放电量(kWh) -->
        </DataBindings>
    </BmsMon>

    <!-- ================================================================
         BmsRun BMS 运行详情页
         包含：三级报警状态 + BMS 详细运行参数
         ================================================================ -->
    <BmsRun>
        <DataBindings>
            <!-- ── 三级报警状态（文本：正常/报警）── -->
            <Bind widget="TotVoltStatus" semanticRole="bms.alarm.totalVoltage" decimals="0"/>   <!-- 总电压状态 -->
            <Bind widget="SingleOverVoltStatus" semanticRole="bms.alarm.cellOverVoltage" decimals="0"/>   <!-- 单体过压状态 -->
            <Bind widget="SingleUnderVoltStatus" semanticRole="bms.alarm.cellUnderVoltage" decimals="0"/>   <!-- 单体欠压状态 -->
            <Bind widget="BatWorkTempStatus" semanticRole="bms.alarm.workTemperature" decimals="0"/>   <!-- 电池工作温度状态 -->
            <Bind widget="SingleTempChange" semanticRole="bms.alarm.cellTemperatureRise" decimals="0"/>   <!-- 单体温升状态 -->
            <Bind widget="SingleTempDiff" semanticRole="bms.alarm.cellTemperatureDifference" decimals="0"/>   <!-- 单体温差状态 -->
            <Bind widget="SingleTemp" semanticRole="bms.alarm.cellTemperature" decimals="0"/>   <!-- 单体温度状态 -->
            <Bind widget="IsolateMon" semanticRole="bms.alarm.insulation" decimals="0"/>   <!-- 绝缘监测状态 -->
            <Bind widget="SocStatus" semanticRole="bms.alarm.soc" decimals="0"/>   <!-- SOC状态 -->
            <Bind widget="SingleVoltDiff" semanticRole="bms.alarm.cellVoltageDifference" decimals="0"/>   <!-- 单体压差状态 -->
            <Bind widget="SingleVoltChange" semanticRole="bms.alarm.cellVoltageChange" decimals="0"/>   <!-- 单体电压变化状态 -->

            <!-- ── BMS 运行参数（数值显示）── -->
            <Bind widget="TotVoltVal" semanticRole="bms.totalVoltage" indexFallback="1566" decimals="1"/>   <!-- 总电压(V) -->
            <Bind widget="TotAmp" semanticRole="bms.totalCurrent" indexFallback="1567" decimals="1"/>   <!-- 总电流(A) -->
            <Bind widget="PackNum" semanticRole="bms.packCount" indexFallback="333" decimals="0"/>   <!-- 电池包数量 -->
            <Bind widget="CellNum" semanticRole="bms.cellCount" indexFallback="334" decimals="0"/>   <!-- 电芯数量 -->
            <Bind widget="IsoVal" semanticRole="bms.insulation" indexFallback="1571" decimals="0"/>   <!-- 绝缘电阻(kΩ) -->
            <Bind widget="PosIsoVal" semanticRole="bms.positiveInsulation" indexFallback="1621" decimals="0"/>   <!-- 正极绝缘电阻(kΩ) -->
            <Bind widget="SingleVoltAvg" semanticRole="bms.averageVoltage" indexFallback="1572" decimals="3"/>  <!-- 单体平均电压(V) -->
            <Bind widget="SingleMinTemp" semanticRole="bms.cell.minTemperature" indexFallback="1583" decimals="1"/>   <!-- 最低单体温度(℃) -->
            <Bind widget="SingleMaxTemp" semanticRole="bms.cell.maxTemperature" indexFallback="1580" decimals="1"/>   <!-- 最高单体温度(℃) -->

            <!-- ── BMS 单体极值参数（数值显示）── -->
            <Bind widget="SingleMaxVolt" semanticRole="bms.cell.maxVoltage" indexFallback="1574" decimals="3"/>   <!-- 单体最高电压(V) -->
