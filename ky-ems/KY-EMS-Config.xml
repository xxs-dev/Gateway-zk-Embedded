            <Column col="1" baseIndex="226" semanticRolePattern="ems.schedule.hour%1.power.current"/>   <!-- 功率 当前值: 226~237 -->
            <Column col="2" baseIndex="238" semanticRolePattern="ems.schedule.hour%1.power.set"/>   <!-- 功率 修改值: 238~249 -->
