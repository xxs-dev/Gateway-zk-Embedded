            <Column col="4" baseIndex="262" semanticRolePattern="ems.schedule.hour%1.soc.set"/>   <!-- SOC 修改值: 262~273 -->
        </Table>

        <!-- ── 定时充放电表格 2（时刻 0~11）── -->
        <Table name="tableChargeParam_2" dataRows="12">
            <Column col="1" baseIndex="274" semanticRolePattern="ems.schedule.hour%1.power.current"/>   <!-- 功率 当前值: 274~285 -->
            <Column col="2" baseIndex="286" semanticRolePattern="ems.schedule.hour%1.power.set"/>   <!-- 功率 修改值: 286~297 -->
            <Column col="3" baseIndex="298" semanticRolePattern="ems.schedule.hour%1.soc.current"/>   <!-- SOC 当前值: 298~309 -->
            <Column col="4" baseIndex="310" semanticRolePattern="ems.schedule.hour%1.soc.set"/>   <!-- SOC 修改值: 310~321 -->
        </Table>
    </ChargeParam>

